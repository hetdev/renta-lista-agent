# AWS — use the working profile (member account, AgentCore unlocked)
AWS_REGION=us-east-1
AWS_PROFILE=rentalista

# Bedrock
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# App
DEMO_MODE=true
BROWSER_SESSION_TIMEOUT_SECONDS=1800
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# Demo limits
MAX_UPLOAD_BYTES=5242880
MAX_FILES_PER_CASE=10
MAX_JOBS_PER_CASE=12
MAX_DAILY_CASES=200
MAX_DAILY_JOBS=300
MAX_BROWSER_SESSIONS=2
